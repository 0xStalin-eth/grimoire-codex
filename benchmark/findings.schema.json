{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Grimoire audit findings",
  "type": "object",
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "root_cause", "impact", "locations", "evidence", "reproduction"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low", "informational", "unknown"]},
          "root_cause": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "locations": {"type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["path", "line"],
            "properties": {"path": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}}
          }},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reproduction": {
            "type": "object", "required": ["status", "command", "result"],
            "properties": {
              "status": {"enum": ["reproduced", "not_reproduced", "not_tested"]},
              "command": {"type": "string", "minLength": 1},
              "result": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
